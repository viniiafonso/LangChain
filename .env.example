# Copie este arquivo para .env e preencha com seus valores
# cp .env.example .env

# URL base do servidor local do LM Studio (ou qualquer servidor compatível com OpenAI)
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234

# Nome exato do modelo carregado no LM Studio
LOCAL_LLM_MODEL=allura-forge_llama-3.3-8b-instruct

# Chave de API (para LM Studio local pode ser qualquer valor; para OpenAI real, use sua chave)
OPENAI_API_KEY=local-key
